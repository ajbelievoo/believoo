    <style>
        /* Fix missing cursor images */
        .gm-style * { cursor: default !important; }
        .gm-style { cursor: default !important; }

        /* Floating orb animations */
        @keyframes floatOrb1 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            25% { transform: translate(50px, 30px) scale(1.1); }
            50% { transform: translate(-30px, 60px) scale(1); }
            75% { transform: translate(-50px, -20px) scale(0.9); }
        }

        @keyframes floatOrb2 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            33% { transform: translate(40px, -40px) scale(1.15); }
            66% { transform: translate(-60px, 20px) scale(0.95); }
        }

        @keyframes floatOrb3 {
            0%, 100% { transform: translate(0, 0) scale(1); }
            50% { transform: translate(-40px, -60px) scale(1.2); }
        }

        /* Pulse glow animation for stats */
        @keyframes statPulse {
            0%, 100% { box-shadow: 0 0 0 0 rgba(0, 183, 255, 0.1); }
            50% { box-shadow: 0 0 20px 5px rgba(0, 183, 255, 0.2); }
        }

        /* Shimmer animation for cards */
        @keyframes cardShimmer {
            0% { background-position: -200% 0; }
            100% { background-position: 200% 0; }
        }

        /* Enhanced glass card with gradient border */
        .glass-premium {
            background: linear-gradient(135deg, rgba(26, 26, 26, 0.8) 0%, rgba(17, 17, 17, 0.9) 100%);
            backdrop-filter: blur(20px) saturate(180%);
            border: 1px solid rgba(255, 255, 255, 0.1);
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.4), inset 0 1px 0 rgba(255, 255, 255, 0.05);
        }

        .glass-premium:hover {
            border-color: rgba(0, 183, 255, 0.3);
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.5), 0 0 30px rgba(0, 183, 255, 0.1);
        }

        /* Animated gradient text */
        .text-gradient-animated {
            background: linear-gradient(90deg, #00b7ff, #7000ff, #ff00a0, #00b7ff);
            background-size: 300% 100%;
            -webkit-background-clip: text;
            background-clip: text;
            color: transparent;
            animation: gradientMove 5s ease infinite;
        }

        @keyframes gradientMove {
            0%, 100% { background-position: 0% 50%; }
            50% { background-position: 100% 50%; }
        }

        /* Status indicator pulse */
        .status-pulse {
            animation: statusPulse 2s infinite;
        }

        @keyframes statusPulse {
            0%, 100% { opacity: 1; }
            50% { opacity: 0.7; }
        }

        /* Button hover lift */
        .btn-lift {
            transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .btn-lift:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 30px rgba(0, 183, 255, 0.3);
        }

        /* Tab glow effect */
        .tab-glow.active {
            background: linear-gradient(135deg, #00b7ff 0%, #0099ff 100%);
            box-shadow: 0 4px 20px rgba(0, 183, 255, 0.4);
        }

        /* Scroll reveal animation */
        .reveal {
            opacity: 0;
            transform: translateY(20px);
            transition: opacity 0.6s ease, transform 0.6s ease;
        }

        .reveal.visible {
            opacity: 1;
            transform: translateY(0);
        }

        /* Stagger delays */
        .stagger-1 { transition-delay: 0.1s; }
        .stagger-2 { transition-delay: 0.2s; }
        .stagger-3 { transition-delay: 0.3s; }
        .stagger-4 { transition-delay: 0.4s; }
    </style>


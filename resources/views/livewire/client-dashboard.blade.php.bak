                            @forelse(Auth::user()->notifications()->latest()->take(5)->get() as $notification)
                                @php
                                    $title = $notification->data['title'] ?? 'Notification';
                                    $body = $notification->data['body'] ?? ($notification->data['message'] ?? '');
                                    $url = null;
                                    
                                    if (isset($notification->data['actions'])) {
                                        foreach ($notification->data['actions'] as $action) {
                                            if (isset($action['url'])) {
                                                $url = $action['url'];
                                                break;
                                            }
                                        }
                                    }
                                    
                                    if (!$url && isset($notification->data['ticket_id'])) {
                                        $url = route('client.dashboard', ['ticket' => $notification->data['ticket_id']]);
                                    }
                                    
                                    if (!$url && isset($notification->data['agreement_id'])) {
                                        $url = $notification->data['action_url'] ?? route('client.agreement.view', $notification->data['agreement_id']);
                                    }
                                @endphp
                                <a href="{{ $url ?? '#' }}" class="block p-6 border-b border-white/5 hover:bg-white/[0.05] transition-all {{ $notification->read_at ? 'opacity-50' : '' }} relative z-[11000008]">
                                    <p class="text-xs text-white font-bold mb-1">{{ $title }}</p>
                                    <p class="text-[10px] text-gray-400 line-clamp-2 mb-2">{{ $body }}</p>
                                    <span class="text-[8px] font-black text-gray-600 uppercase">{{ $notification->created_at->diffForHumans() }}</span>
                                </a>

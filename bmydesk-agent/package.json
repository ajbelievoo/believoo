{
    "name": "bmydesk-agent",
    "productName": "BMyDesk Agent",
    "version": "1.0.0",
    "description": "BMyDesk remote desktop agent — share your screen with a session code and allow remote control.",
    "main": "main.js",
    "scripts": {
        "start": "electron .",
        "pack": "electron-builder --dir",
        "dist": "electron-builder",
        "dist:win": "electron-builder --win",
        "dist:win:zip": "electron-builder --win zip"
    },
    "dependencies": {
        "@nut-tree-fork/nut-js": "^4.2.6",
        "pusher-js": "^8.4.0"
    },
    "devDependencies": {
        "electron": "^33.4.0",
        "electron-builder": "^25.1.8"
    },
    "build": {
        "appId": "com.believoo.bmydesk.agent",
        "productName": "BMyDesk Agent",
        "directories": { "output": "dist" },
        "win": {
            "target": ["nsis", "zip"]
        },
        "nsis": {
            "oneClick": true,
            "perMachine": false,
            "allowToChangeInstallationDirectory": false
        },
        "mac": {
            "target": "dmg",
            "category": "public.app-category.utilities"
        },
        "linux": {
            "target": "AppImage"
        }
    }
}

# Believoo Shield Pro - Environment Configuration
# Copy this file to .env and update values for production

# Application
DEBUG=false
ENVIRONMENT=production
HOST=0.0.0.0
PORT=8443

# Database (SQLite for dev, MySQL for production)
DATABASE_URL=sqlite:///./shield_pro.db
# DATABASE_URL=mysql+pymysql://shield_user:secure_pass@localhost/shield_pro

# Security (CHANGE THESE IN PRODUCTION!)
SECRET_KEY=change-me-to-a-256-bit-random-key
ADMIN_API_KEY=bhost-admin-api-key-ultra-secure-2024

# Licensing
LICENSE_ENCRYPTION_SALT=believoo-unique-salt-value

# Cloud Sync / Backup
SFTP_HOST=sftp.believoo.com
SFTP_PORT=22
SFTP_USER=shield_backup
